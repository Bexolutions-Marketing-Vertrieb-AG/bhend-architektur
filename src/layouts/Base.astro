---
import ConsentScripts from "~/components/layout/ConsentScripts.astro"
import Footer from "~/components/layout/Footer.astro"
import Navigation from "~/components/layout/Navigation.astro"
import JsonLd from "~/components/seo/JsonLd.astro"
import type { Locale } from "~/config/locales"
import {
  organizationLogo,
  organizationName,
  siteDescription,
  siteName,
  siteUrl,
} from "~/lib/site"
import "~/styles/global.css"

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const orgGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: organizationName(),
      url: siteUrl(),
      logo: organizationLogo(),
    },
    {
      "@type": "WebSite",
      name: siteName(),
      url: siteUrl(),
      description: siteDescription(),
      publisher: { "@type": "Organization", name: organizationName() },
    },
  ],
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="white" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Roboto+Condensed:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    <JsonLd data={orgGraph} />
    <ConsentScripts />
  </head>
  <body class="flex min-h-screen flex-col">
    <Navigation locale={locale} />
    <slot />
    <Footer locale={locale} />
  </body>
</html>
