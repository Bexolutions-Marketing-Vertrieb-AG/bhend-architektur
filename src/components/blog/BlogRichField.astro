---
import SafeHtml from "~/components/common/SafeHtml.astro"
import { looksLikeHtml } from "~/lib/sanitize"

interface Props {
  value: string
  proseClass?: string
  plainClass?: string
}

const {
  value,
  proseClass = "blog-prose",
  plainClass = "section-lead whitespace-pre-line",
} = Astro.props
---

{
  looksLikeHtml(value) ? (
    <SafeHtml html={value} class={proseClass} />
  ) : (
    <p class={plainClass}>{value}</p>
  )
}
