---
import { bf } from "~/lib/bf"
import type { Locale } from "~/config/locales"

interface Props {
  locale: Locale
}

const { locale: _locale } = Astro.props

type MenuChild = { href: string; label: string }
type MenuItem =
  | { label: string; href: string; children?: undefined }
  | { label: string; href?: undefined; children: MenuChild[] }

const menu: MenuItem[] = [
  {
    label: "Über uns",
    children: [
      { href: "/ueber-uns/team", label: "Team" },
      { href: "/ueber-uns/mitgliedschaften", label: "Mitgliedschaften" },
      { href: "/ueber-uns/presse-extern", label: "Presse / Extern" },
    ],
  },
  {
    label: "Leistungen",
    children: [
      { href: "/planung", label: "Planung" },
      { href: "/beratung", label: "Beratung" },
      { href: "/brandschutz", label: "Brandschutz" },
      { href: "/realisierung", label: "Realisierung" },
      { href: "/energieberatung", label: "Energieberatung" },
      { href: "/bauherrenberatung", label: "Bauherrenberatung" },
    ],
  },
  { href: "/aktuell", label: "Aktuell" },
  {
    label: "Referenzen",
    children: [
      { href: "/wohnen", label: "Wohnen" },
      { href: "/industrie-gewerbe", label: "Industrie Gewerbe" },
      { href: "/oeffentliche-bauten", label: "Öffentliche Bauten" },
    ],
  },
  { href: "/bei-uns-arbeiten", label: "Bei uns arbeiten" },
  { href: "mailto:info@bhend-architektur.ch", label: "Kontakt" },
]
---

<footer
  class="bg-brand-900 mt-auto text-white"
  {...bf("chrome.footer.shell", "container", "footer")}
>
  <div
    class="container-wide grid grid-cols-2 gap-x-6 gap-y-12 py-16 lg:grid-cols-[226px_164px_284px_156px] lg:gap-16"
  >
    <a
      href="/"
      class="col-span-2 block lg:col-span-1"
      {...bf("chrome.footer.logo", "image", "footer")}
    >
      <img
        src="/images/logo.png"
        alt="Bhend Architektur"
        width="226"
        height="64"
        class="h-16 w-auto brightness-0 invert"
      />
    </a>

    <div>
      <h2 class="font-display mb-6 text-xl font-bold sm:text-2xl">Menu</h2>
      <ul class="space-y-3 text-sm">
        {
          menu.map((item) =>
            item.children ? (
              <li>
                <details class="group">
                  <summary class="enter:text-brand-200 flex cursor-pointer list-none items-center gap-2 transition-colors [&::-webkit-details-marker]:hidden">
                    <span>{item.label}</span>
                    <span
                      class="text-brand-200 group-open:hidden"
                      aria-hidden="true"
                    >
                      +
                    </span>
                    <span
                      class="text-brand-200 hidden group-open:inline"
                      aria-hidden="true"
                    >
                      –
                    </span>
                  </summary>
                  <ul class="border-brand-700 mt-2 ml-1 space-y-2 border-l pl-3">
                    {item.children.map((child) => (
                      <li>
                        <a
                          class="enter:text-brand-200 text-brand-200 transition-colors"
                          href={child.href}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a
                  class="enter:text-brand-200 transition-colors"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </div>

    <div {...bf("chrome.footer.contact", "style_target", "footer")}>
      <h2 class="font-display mb-6 text-xl font-bold sm:text-2xl">Kontakt</h2>
      <address class="space-y-4 text-sm leading-relaxed not-italic">
        <p>
          Bhend Architektur AG<br />
          Zofingerstrasse 43<br />
          4665 Oftringen
        </p>
        <p>
          <a class="enter:text-brand-200" href="tel:+41627980000"
            >+41 62 798 00 00</a
          >
        </p>
        <p>
          <a
            class="enter:text-brand-200"
            href="mailto:info@bhend-architektur.ch">info@bhend-architektur.ch</a
          >
        </p>
      </address>
    </div>

    <div class="col-span-2 lg:col-span-1">
      <h2 class="font-display mb-6 text-xl font-bold sm:text-2xl">
        Social Media
      </h2>
      <p class="text-brand-200 mb-8 text-sm">LinkedIn · Instagram · Facebook</p>
      <a
        href="/impressum"
        class="enter:text-brand-200 text-sm"
        {...bf("chrome.footer.impressum", "chrome_denied", "footer")}
      >
        Impressum
      </a>
    </div>
  </div>
</footer>
