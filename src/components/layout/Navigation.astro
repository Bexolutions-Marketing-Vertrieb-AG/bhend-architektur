---
import { phrases } from "~/lib/phrases"
import { translate } from "~/lib/i18n"
import type { Locale } from "~/config/locales"
import { siteName } from "~/lib/site"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<header class="border-b border-neutral-200">
  <nav
    class="container-wide flex items-center justify-between gap-6 py-4"
    aria-label={translate(phrases.menu, locale)}
  >
    <a
      href="/"
      class="flex items-center gap-2 text-lg font-semibold tracking-tight text-neutral-900"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 32 32"
        aria-hidden="true"
        class="text-brand-900 shrink-0"
      >
        <rect width="32" height="32" rx="7" fill="currentColor"></rect>
        <circle
          cx="16"
          cy="16"
          r="6.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          opacity="0.45"></circle>
      </svg>
      {siteName()}
    </a>
    <ul class="flex items-center gap-6 text-sm text-neutral-600">
      <li>
        <a class="enter:text-brand-700 transition-colors" href="/">
          {translate(phrases.homepage, locale)}
        </a>
      </li>
      <li>
        <a class="enter:text-brand-700 transition-colors" href="/posts">
          {translate(phrases.posts, locale)}
        </a>
      </li>
    </ul>
  </nav>
</header>
