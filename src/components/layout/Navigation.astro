---
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import { phrases } from "~/lib/phrases"
import type { Locale } from "~/config/locales"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/"
const menuLabel = translate(phrases.menu, locale)

type NavChild = { href: string; label: string }
type NavItem =
  | { label: string; href: string; children?: undefined }
  | { label: string; href?: undefined; children: NavChild[] }

const links: NavItem[] = [
  {
    label: "Über uns",
    children: [
      { href: "/ueber-uns/team", label: "Team" },
      { href: "/ueber-uns/mitgliedschaften", label: "Mitgliedschaften" },
      { href: "/ueber-uns/presse-extern", label: "Presse / Extern" },
    ],
  },
  {
    label: "Leistungen",
    children: [
      { href: "/planung", label: "Planung" },
      { href: "/beratung", label: "Beratung" },
      { href: "/brandschutz", label: "Brandschutz" },
      { href: "/realisierung", label: "Realisierung" },
      { href: "/energieberatung", label: "Energieberatung" },
      { href: "/bauherrenberatung", label: "Bauherrenberatung" },
    ],
  },
  { href: "/aktuell", label: "Aktuell" },
  {
    label: "Referenzen",
    children: [
      { href: "/wohnen", label: "Wohnen" },
      { href: "/industrie-gewerbe", label: "Industrie Gewerbe" },
      { href: "/oeffentliche-bauten", label: "Öffentliche Bauten" },
    ],
  },
  { href: "/bei-uns-arbeiten", label: "Bei uns arbeiten" },
  { href: "/blog", label: "Blog" },
]

const contactHref = "/kontakt"

function isActive(href: string): boolean {
  return pathname === href || pathname.startsWith(`${href}/`)
}

function isGroupActive(children: NavChild[]): boolean {
  return children.some((child) => isActive(child.href))
}
---

<header
  class="relative z-50 bg-white"
  {...bf("chrome.nav.shell", "container", "nav")}
>
  <nav
    class="container-wide flex items-center justify-between gap-3 py-4 lg:gap-6 lg:py-10"
    aria-label={menuLabel}
  >
    <a href="/" class="shrink-0" {...bf("chrome.nav.logo", "image", "nav")}>
      <img
        src="/images/logo.png"
        alt="Bhend Architektur"
        width="198"
        height="56"
        class="h-10 w-auto lg:h-14"
      />
    </a>

    <ul
      class="text-ink hidden items-center gap-6 text-center font-sans text-base leading-normal font-normal uppercase lg:flex"
    >
      {
        links.map((link) =>
          link.children ? (
            <li
              class:list={[
                "nav-dropdown group relative",
                isGroupActive(link.children) && "is-active",
              ]}
            >
              <button
                type="button"
                class="nav-dropdown-trigger enter:text-brand-500 text-ink group-hover:text-brand-500 group-focus-within:text-brand-500 inline-flex items-center gap-1 bg-transparent p-0 font-sans text-base leading-normal font-normal uppercase transition-colors"
                aria-haspopup="menu"
              >
                {link.label}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 20 20"
                  fill="none"
                  aria-hidden="true"
                  class="text-brand-500 transition-transform group-focus-within:rotate-180 group-hover:rotate-180"
                >
                  <path
                    d="M1.5 6.15817L3.0975 4.5L10.5 12.1837L17.9025 4.5L19.5 6.15817L10.5 15.5L1.5 6.15817Z"
                    fill="currentColor"
                  />
                </svg>
              </button>
              <ul
                class="nav-dropdown-panel text-ink absolute top-full left-0 z-30 min-w-[220px] bg-white py-4 shadow-sm"
                role="menu"
              >
                {link.children.map((child) => (
                  <li role="none">
                    <a
                      role="menuitem"
                      href={child.href}
                      class:list={[
                        "enter:text-brand-500 block px-5 py-2.5 transition-colors",
                        isActive(child.href) && "text-brand-500",
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                class:list={[
                  "enter:text-brand-500 transition-colors",
                  isActive(link.href) && "text-brand-500",
                ]}
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          ),
        )
      }
    </ul>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <a
        href={contactHref}
        class="btn-primary max-lg:px-4 max-lg:py-2.5 max-lg:text-xs"
        {...bf("chrome.nav.cta", "chrome_denied", "nav")}
      >
        Kontakt
      </a>

      <details class="group/mobile-nav relative lg:hidden">
        <summary
          class="text-ink enter:text-brand-500 flex size-11 cursor-pointer list-none items-center justify-center [&::-webkit-details-marker]:hidden"
          aria-label={menuLabel}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
            class="group-open/mobile-nav:hidden"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
            class="hidden group-open/mobile-nav:block"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>

        <div
          class="border-brand-200 absolute top-[calc(100%+0.75rem)] right-0 z-50 max-h-[min(75dvh,36rem)] w-[min(calc(100vw-1.5rem),22rem)] overflow-y-auto border bg-white shadow-lg"
        >
          <ul
            class="text-ink divide-brand-100 divide-y p-2 text-center font-sans text-base leading-normal font-normal uppercase"
          >
            {
              links.map((link) =>
                link.children ? (
                  <li>
                    <details class="group/mobile-sub">
                      <summary class="enter:text-brand-500 flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3.5 [&::-webkit-details-marker]:hidden">
                        <span
                          class:list={[
                            isGroupActive(link.children) && "text-brand-500",
                          ]}
                        >
                          {link.label}
                        </span>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="20"
                          height="20"
                          viewBox="0 0 20 20"
                          fill="none"
                          aria-hidden="true"
                          class="text-brand-500 transition-transform group-open/mobile-sub:rotate-180"
                        >
                          <path
                            d="M1.5 6.15817L3.0975 4.5L10.5 12.1837L17.9025 4.5L19.5 6.15817L10.5 15.5L1.5 6.15817Z"
                            fill="currentColor"
                          />
                        </svg>
                      </summary>
                      <ul class="border-brand-100 mb-2 ml-4 space-y-1 border-l pb-2 pl-3 font-normal">
                        {link.children.map((child) => (
                          <li>
                            <a
                              href={child.href}
                              class:list={[
                                "enter:text-brand-500 block py-2 uppercase",
                                isActive(child.href) && "text-brand-500",
                              ]}
                            >
                              {child.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ) : (
                  <li>
                    <a
                      href={link.href}
                      class:list={[
                        "enter:text-brand-500 block px-4 py-3.5",
                        isActive(link.href) && "text-brand-500",
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                ),
              )
            }
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>
