---
// SectionCultureBand.astro — centered culture headline + body
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  id?: string
  title?: I18nString
  heading?: I18nString
  subheading?: I18nString
  body?: I18nString
  locale: Locale
}

const {
  id = "cultureBand",
  title,
  heading,
  subheading,
  body,
  locale,
} = Astro.props

const section = id
const headline = translate(heading ?? title, locale)
const sub = translate(subheading, locale)
const copy = translate(body, locale)
// Desktop: two lines after the first sentence; mobile wraps naturally.
const copyLines = copy
  .split(/\n+/)
  .map((line) => line.trim())
  .filter(Boolean)
const copyParts =
  copyLines.length >= 2
    ? copyLines
    : (() => {
        const match = /^(.*?[.!?])\s+(.+)$/s.exec(copy.trim())
        return match ? [match[1], match[2]] : copy ? [copy] : []
      })()
---

<section class="bg-white" {...bf(`${section}.shell`, "container", section)}>
  <div
    class="container-wide py-section-sm md:py-section flex flex-col items-center gap-4 text-center"
  >
    {
      headline && (
        <h2
          class="font-display max-w-md text-3xl font-bold tracking-tight uppercase md:text-4xl"
          {...bf(`${section}.heading`, "style_target", section)}
        >
          {headline}
        </h2>
      )
    }
    {
      sub && (
        <p
          class="font-display text-lg font-bold tracking-tight uppercase md:text-xl"
          {...bf(`${section}.subheading`, "style_target", section)}
        >
          {sub}
        </p>
      )
    }
    {
      copyParts.length > 0 && (
        <p
          class="text-ink mt-2 max-w-4xl text-center font-sans text-base leading-normal font-normal md:text-[20px]"
          {...bf(`${section}.body`, "style_target", section)}
        >
          {copyParts.map((part, index) => (
            <>
              {index > 0 && (
                <>
                  <br class="hidden md:inline" />
                  <span class="md:hidden"> </span>
                </>
              )}
              {part}
            </>
          ))}
        </p>
      )
    }
  </div>
</section>
