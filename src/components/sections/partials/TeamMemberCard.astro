---
/**
 * Team member card — CMS member shape:
 * {
 *   "name": { "de": "…" },
 *   "role": { "de": "…" },
 *   "studies": [{ "de": "…" }],
 *   "image": "/images/team/….jpg",
 *   "imageAlt": { "de": "…" },
 *   "phone": "+41 …",
 *   "email": "name@bhend-architektur.ch",
 *   "mailLabel": { "de": "Mail" }
 * }
 */
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

export interface TeamMember {
  name?: I18nString
  role?: I18nString
  studies?: I18nString[]
  image?: string
  imageAlt?: I18nString
  phone?: string
  email?: string
  mailLabel?: I18nString
}

interface Props {
  member: TeamMember
  locale: Locale
  bfPrefix: string
  section: string
}

const { member, locale, bfPrefix, section } = Astro.props

const name = translate(member.name, locale)
const nameParts = name.replace(/\n+/g, " ").trim().split(/\s+/).filter(Boolean)
const nameLead = nameParts.slice(0, -1).join(" ")
const nameTail = nameParts.at(-1) ?? ""
const alt = translate(member.imageAlt, locale) || name.replace(/\n+/g, " ")
const mailLabel = translate(member.mailLabel, locale) || "Mail"
const role = translate(member.role, locale)
const studies = (member.studies ?? [])
  .map((item) => translate(item, locale))
  .filter(Boolean)
const phone = (member.phone ?? "").trim()
const email = (member.email ?? "").trim()
const expandable = studies.length > 0

const telHref = (value: string) => {
  const digits = value.replace(/[^\d+]/g, "")
  return digits ? `tel:${digits}` : "#"
}

const nameBf = bf(`${bfPrefix}Name`, "style_target", section)
const roleBf = bf(`${bfPrefix}Role`, "style_target", section)
const studiesBf = bf(`${bfPrefix}Studies`, "style_target", section)
---

<li class="flex flex-col items-center gap-4 text-center">
  {
    member.image && (
      <img
        src={member.image}
        alt={alt}
        class="aspect-square w-full object-cover object-top"
        width="241"
        height="241"
        loading="lazy"
        {...bf(`${bfPrefix}Image`, "image", section)}
      />
    )
  }
  {
    expandable ? (
      <details class="group w-full">
        <summary class="cursor-pointer list-none text-center [&::-webkit-details-marker]:hidden">
          <h2
            class="font-display text-ink text-[22px] leading-8 font-bold md:text-[28px] md:leading-10"
            {...nameBf}
          >
            {nameLead && <>{nameLead} </>}
            <span class="whitespace-nowrap">
              {nameTail}
              <span class="group-open:hidden" aria-hidden="true">
                {"\u00A0"}+
              </span>
              <span class="hidden group-open:inline" aria-hidden="true">
                {"\u00A0"}–
              </span>
            </span>
          </h2>
          {role && (
            <p
              class="text-ink mt-1 font-sans text-base leading-normal font-normal"
              {...roleBf}
            >
              {role}
            </p>
          )}
        </summary>
        <ul
          class="text-ink mt-2 space-y-4 font-sans text-base leading-snug font-normal"
          {...studiesBf}
        >
          {studies.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </details>
    ) : (
      <div class="w-full text-center">
        {name && (
          <h2
            class="font-display text-ink text-[22px] leading-8 font-bold md:text-[28px] md:leading-10"
            {...nameBf}
          >
            {nameLead && <>{nameLead} </>}
            <span class="whitespace-nowrap">
              {nameTail}
              <span aria-hidden="true">{"\u00A0"}–</span>
            </span>
          </h2>
        )}
        {role && (
          <p
            class="text-ink mt-1 font-sans text-base leading-normal font-normal"
            {...roleBf}
          >
            {role}
          </p>
        )}
      </div>
    )
  }
  <div
    class="mt-auto flex w-full flex-col items-center gap-2 pt-2 font-sans text-base leading-normal font-bold md:text-[18px]"
  >
    {
      phone && (
        <a
          href={telHref(phone)}
          class="enter:text-brand-500 text-brand-500 inline-flex items-center justify-center gap-2 underline"
          {...bf(`${bfPrefix}Phone`, "chrome_denied", section)}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 32 32"
            fill="currentColor"
            aria-hidden="true"
            class="size-4 shrink-0 md:size-5"
          >
            <path d="M26.6 28C23.8222 28 21.0778 27.3944 18.3667 26.1833C15.6556 24.9722 13.1889 23.2556 10.9667 21.0333C8.74444 18.8111 7.02778 16.3444 5.81667 13.6333C4.60556 10.9222 4 8.17778 4 5.4C4 5 4.13333 4.66667 4.4 4.4C4.66667 4.13333 5 4 5.4 4H10.8C11.1111 4 11.3889 4.10556 11.6333 4.31667C11.8778 4.52778 12.0222 4.77778 12.0667 5.06667L12.9333 9.73333C12.9778 10.0889 12.9667 10.3889 12.9 10.6333C12.8333 10.8778 12.7111 11.0889 12.5333 11.2667L9.3 14.5333C9.74444 15.3556 10.2722 16.15 10.8833 16.9167C11.4944 17.6833 12.1667 18.4222 12.9 19.1333C13.5889 19.8222 14.3111 20.4611 15.0667 21.05C15.8222 21.6389 16.6222 22.1778 17.4667 22.6667L20.6 19.5333C20.8 19.3333 21.0611 19.1833 21.3833 19.0833C21.7056 18.9833 22.0222 18.9556 22.3333 19L26.9333 19.9333C27.2444 20.0222 27.5 20.1833 27.7 20.4167C27.9 20.65 28 20.9111 28 21.2V26.6C28 27 27.8667 27.3333 27.6 27.6C27.3333 27.8667 27 28 26.6 28Z" />
          </svg>
          {phone}
        </a>
      )
    }
    {
      email && (
        <a
          href={`mailto:${email}`}
          class="enter:text-brand-500 text-brand-500 inline-flex items-center justify-center gap-2 underline"
          {...bf(`${bfPrefix}Mail`, "chrome_denied", section)}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 20"
            fill="currentColor"
            aria-hidden="true"
            class="h-3.5 w-4 shrink-0 md:h-4 md:w-5"
          >
            <path d="M2.4 20C1.74 20 1.175 19.7552 0.705 19.2656C0.235 18.776 0 18.1875 0 17.5V2.5C0 1.8125 0.235 1.22396 0.705 0.734375C1.175 0.244792 1.74 0 2.4 0H21.6C22.26 0 22.825 0.244792 23.295 0.734375C23.765 1.22396 24 1.8125 24 2.5V17.5C24 18.1875 23.765 18.776 23.295 19.2656C22.825 19.7552 22.26 20 21.6 20H2.4ZM12 11.25L21.6 5V2.5L12 8.75L2.4 2.5V5L12 11.25Z" />
          </svg>
          {mailLabel}
        </a>
      )
    }
  </div>
</li>
