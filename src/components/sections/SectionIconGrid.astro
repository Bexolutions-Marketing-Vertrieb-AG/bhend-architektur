---
// SectionIconGrid.astro — three-column icon cards (audience / challenges / steps)
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Item {
  title?: I18nString
  text?: I18nString
  body?: I18nString
  icon?: string
}

interface Props {
  id?: string
  title?: I18nString
  items?: Item[]
  locale: Locale
}

const { id = "iconGrid", title, items = [], locale } = Astro.props
const heading = translate(title, locale)
const section = id
const isProcess = section === "process"
const headingLines = (() => {
  const lines = heading
    .split(/\n+/)
    .map((line) => line.trim())
    .filter(Boolean)
  if (!isProcess || lines.length === 0) return lines
  // Lead + subline ("In drei…"); keep natural wrapping spaces for mobile.
  if (lines.length === 1) return lines
  const last = lines[lines.length - 1] ?? ""
  const lead = lines.slice(0, -1).join(" ")
  return [lead, last]
})()
---

<section
  class="bg-surface overflow-x-clip"
  {...bf(`home.${section}.shell`, "container", section)}
>
  <div class="container-wide py-section-sm md:py-section">
    {
      headingLines.length > 0 &&
        (isProcess ? (
          <div class="mx-auto mb-10 flex w-full max-w-4xl flex-col items-center px-1 text-center md:mb-12">
            {headingLines.map((line, index) => {
              const isLast = index === headingLines.length - 1
              // Lead: 58/66 desktop (−6 from 64/72); smaller wrap-friendly mobile sizes.
              return (
                <h2
                  class:list={[
                    "w-full max-w-full text-center text-balance break-words",
                    isLast
                      ? "heading-section text-ink mt-3 md:mt-[15px]"
                      : "heading-page text-ink md:text-[58px] md:leading-[66px]",
                  ]}
                  {...bf(
                    index === 0
                      ? `home.${section}.heading`
                      : `home.${section}.heading${index + 1}`,
                    "style_target",
                    section,
                  )}
                >
                  {line}
                </h2>
              )
            })}
          </div>
        ) : (
          <h2
            class="section-heading mx-auto mb-12 max-w-4xl text-center"
            {...bf(`home.${section}.heading`, "style_target", section)}
          >
            {heading}
          </h2>
        ))
    }
    <ul class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {
        items.map((item, index) => {
          const itemTitle = translate(item.title, locale)
          const itemBody = translate(item.text ?? item.body, locale)
          return (
            <li class="flex min-w-0 flex-col items-center gap-4 text-center">
              {item.icon && (
                <img
                  src={item.icon}
                  alt=""
                  class="mx-auto size-[120px] object-contain"
                  width="120"
                  height="120"
                  loading="lazy"
                  {...bf(
                    `home.${section}.item${index + 1}Icon`,
                    "image",
                    section,
                  )}
                />
              )}
              {itemTitle && (
                <h3
                  class="font-display text-ink w-full max-w-full text-center text-[32px] leading-10 font-bold break-words whitespace-pre-line"
                  {...bf(
                    `home.${section}.item${index + 1}Title`,
                    "style_target",
                    section,
                  )}
                >
                  {itemTitle}
                </h3>
              )}
              {itemBody && (
                <p
                  class="text-ink w-full max-w-full text-center font-sans text-xl leading-normal font-medium break-words"
                  {...bf(
                    `home.${section}.item${index + 1}Body`,
                    "style_target",
                    section,
                  )}
                >
                  {itemBody}
                </p>
              )}
            </li>
          )
        })
      }
    </ul>
  </div>
</section>
