---
// SectionIconGrid.astro — three-column icon cards (audience / challenges / steps)
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Item {
  title?: I18nString
  text?: I18nString
  body?: I18nString
  icon?: string
}

interface Props {
  id?: string
  title?: I18nString
  items?: Item[]
  locale: Locale
}

const { id = "iconGrid", title, items = [], locale } = Astro.props
const heading = translate(title, locale)
const section = id
const isProcess = section === "process"
const headingLines = (() => {
  const lines = heading
    .split(/\n+/)
    .map((line) => line.trim())
    .filter(Boolean)
  if (!isProcess || lines.length === 0) return lines
  // Lead stays one line ("… mit Bhend Architektur"); last line is the 48/56 subline.
  if (lines.length === 1) return lines
  const last = lines[lines.length - 1] ?? ""
  const lead = lines
    .slice(0, -1)
    .join(" ")
    .replace(/\s+mit\s+/u, "\u00A0mit\u00A0")
  return [lead, last]
})()
---

<section
  class="bg-surface"
  {...bf(`home.${section}.shell`, "container", section)}
>
  <div class="container-wide py-section-sm md:py-section">
    {
      headingLines.length > 0 &&
        (isProcess ? (
          <div class="mx-auto mb-12 flex max-w-4xl flex-col text-center">
            {headingLines.map((line, index) => {
              const isLast = index === headingLines.length - 1
              // Lead lines (64/72); last line "In drei…" (48/56) with 15px gap
              return (
                <h2
                  class:list={[
                    isLast
                      ? "font-display text-ink mt-[15px] text-[32px] leading-10 font-bold md:text-[48px] md:leading-[56px]"
                      : "font-display text-ink text-[40px] leading-[48px] font-bold md:text-[64px] md:leading-[72px] md:whitespace-nowrap",
                  ]}
                  {...bf(
                    index === 0
                      ? `home.${section}.heading`
                      : `home.${section}.heading${index + 1}`,
                    "style_target",
                    section,
                  )}
                >
                  {line}
                </h2>
              )
            })}
          </div>
        ) : (
          <h2
            class="section-heading mx-auto mb-12 max-w-4xl text-center"
            {...bf(`home.${section}.heading`, "style_target", section)}
          >
            {heading}
          </h2>
        ))
    }
    <ul class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {
        items.map((item, index) => {
          const itemTitle = translate(item.title, locale)
          const itemBody = translate(item.text ?? item.body, locale)
          return (
            <li class="flex flex-col items-center gap-4 text-center">
              {item.icon && (
                <img
                  src={item.icon}
                  alt=""
                  class="mx-auto size-[120px] object-contain"
                  width="120"
                  height="120"
                  loading="lazy"
                  {...bf(
                    `home.${section}.item${index + 1}Icon`,
                    "image",
                    section,
                  )}
                />
              )}
              {itemTitle && (
                <h3
                  class="font-display text-ink text-center text-[32px] leading-10 font-bold whitespace-pre-line"
                  {...bf(
                    `home.${section}.item${index + 1}Title`,
                    "style_target",
                    section,
                  )}
                >
                  {itemTitle}
                </h3>
              )}
              {itemBody && (
                <p
                  class="text-ink text-center font-sans text-xl leading-normal font-medium"
                  {...bf(
                    `home.${section}.item${index + 1}Body`,
                    "style_target",
                    section,
                  )}
                >
                  {itemBody}
                </p>
              )}
            </li>
          )
        })
      }
    </ul>
  </div>
</section>
