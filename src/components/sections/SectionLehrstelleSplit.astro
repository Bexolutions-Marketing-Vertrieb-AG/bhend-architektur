---
// SectionLehrstelleSplit.astro — why apprenticeship + CTA | portrait photo
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  id?: string
  title?: I18nString
  heading?: I18nString
  subheading?: I18nString
  body?: I18nString
  image?: string
  imageAlt?: I18nString
  ctaLabel?: I18nString
  dialogId?: string
  defaultApplicationType?: string
  locale: Locale
}

const {
  id = "lehrstelleSplit",
  title,
  heading,
  subheading,
  body,
  image,
  imageAlt,
  ctaLabel,
  dialogId = "application-schnuppertage",
  defaultApplicationType = "Schnuppertag",
  locale,
} = Astro.props

const section = id
const headline = translate(heading ?? title, locale)
const sub = translate(subheading, locale)
const copy = translate(body, locale)
const paragraphs = copy
  .split("\n")
  .map((paragraph) => paragraph.trim())
  .filter(Boolean)
const cta = translate(ctaLabel, locale)
const alt = translate(imageAlt, locale) || headline
---

<section class="bg-white" {...bf(`${section}.shell`, "container", section)}>
  <div
    class="container-wide pb-section-sm md:pt-section-sm md:pb-section pt-[10px]"
  >
    <div
      class="grid items-start gap-10 lg:grid-cols-[minmax(0,685px)_minmax(0,465px)] lg:gap-12"
    >
      <div class="flex flex-col gap-6">
        {
          headline && (
            <h2
              class="font-display text-ink text-[25.6px] leading-8 font-bold break-words md:text-[32px] md:leading-10"
              {...bf(`${section}.heading`, "style_target", section)}
            >
              {headline}
            </h2>
          )
        }
        {
          sub && (
            <p
              class="font-display text-ink text-[22.4px] leading-8 font-bold break-words md:text-[28px] md:leading-10"
              {...bf(`${section}.subheading`, "style_target", section)}
            >
              {sub}
            </p>
          )
        }
        {
          copy && (
            <div
              class="flex flex-col gap-4"
              {...bf(`${section}.body`, "style_target", section)}
            >
              {paragraphs.map((paragraph) => (
                <p class="section-lead">{paragraph}</p>
              ))}
            </div>
          )
        }
        {
          cta && (
            <button
              type="button"
              class="btn-primary mt-2 w-fit max-w-full text-left"
              data-open-application={dialogId}
              data-application-type={defaultApplicationType}
              {...bf(`${section}.cta`, "chrome_denied", section)}
            >
              {cta}
            </button>
          )
        }
      </div>
      {
        image && (
          <img
            src={image}
            alt={alt}
            class="aspect-[465/550] w-full object-cover"
            width="465"
            height="550"
            loading="lazy"
            decoding="async"
            {...bf(`${section}.image`, "image", section)}
          />
        )
      }
    </div>
  </div>
</section>
