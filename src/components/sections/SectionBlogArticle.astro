---
// SectionBlogArticle.astro — blog post template (hero + TOC + blocks + FAQ + CTAs)
import BlogArticleBlocks from "~/components/blog/BlogArticleBlocks.astro"
import BlogArticleClosing from "~/components/blog/BlogArticleClosing.astro"
import BlogArticleFaq from "~/components/blog/BlogArticleFaq.astro"
import BlogArticleToc from "~/components/blog/BlogArticleToc.astro"
import type {
  BlogAuthorBox,
  BlogBlock,
  BlogFaqItem,
  BlogTocItem,
} from "~/components/blog/types"
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import { resolveReservationHref } from "~/lib/reservation"
import type { ReservationMode } from "~/lib/reservation"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  id?: string
  title?: I18nString
  heading?: I18nString
  subheading?: I18nString
  image?: string
  imageAlt?: I18nString
  tocLabel?: I18nString
  toc?: BlogTocItem[]
  blocks?: BlogBlock[]
  faqHeading?: I18nString
  faq?: BlogFaqItem[]
  faqAnchorId?: string
  midCtaLabel?: I18nString
  summaryHeading?: I18nString
  summaryBody?: I18nString
  summaryAnchorId?: string
  closingHeading?: I18nString
  closingBody?: I18nString
  closingCtaLabel?: I18nString
  closingAnchorId?: string
  quote?: I18nString
  quoteAttribution?: I18nString
  authorBox?: BlogAuthorBox
  reservationMode?: ReservationMode
  reservationTarget?: string
  ctaHref?: string
  locale: Locale
}

const {
  id = "blogArticle",
  title,
  heading,
  subheading,
  image,
  imageAlt,
  tocLabel,
  toc = [],
  blocks = [],
  faqHeading,
  faq = [],
  faqAnchorId = "faq",
  midCtaLabel,
  summaryHeading,
  summaryBody,
  summaryAnchorId = "summary",
  closingHeading,
  closingBody,
  closingCtaLabel,
  closingAnchorId = "closing",
  quote,
  quoteAttribution,
  authorBox,
  reservationMode = "mailto",
  reservationTarget = "info@bhend-architektur.ch",
  ctaHref,
  locale,
} = Astro.props

const section = id
const headline = translate(heading ?? title, locale)
const sub = translate(subheading, locale)
const alt = translate(imageAlt, locale) || headline
const midCta = translate(midCtaLabel, locale)
const quoteText = translate(quote, locale)
const quoteAttr = translate(quoteAttribution, locale)
const href = resolveReservationHref({
  reservationMode,
  reservationTarget,
  ctaHref,
})
---

<section class="bg-white" {...bf(`${section}.shell`, "container", section)}>
  {
    image && (
      <div class="w-full">
        <img
          src={image}
          alt={alt}
          class="aspect-[1400/501] max-h-[32rem] w-full object-cover"
          width="1400"
          height="501"
          loading="eager"
          {...bf(`${section}.image`, "image", section, {
            presentation: "background",
          })}
        />
      </div>
    )
  }

  <div class="container-prose py-section-sm md:py-section">
    {
      headline && (
        <h1
          class="font-display mb-4 text-3xl font-bold tracking-tight uppercase md:text-4xl md:leading-tight"
          {...bf(`${section}.heading`, "style_target", section)}
        >
          {headline}
        </h1>
      )
    }
    {
      sub && (
        <p
          class="section-lead text-ink mb-8 font-semibold italic md:mb-10"
          {...bf(`${section}.subheading`, "style_target", section)}
        >
          {sub}
        </p>
      )
    }

    <BlogArticleToc
      section={section}
      tocLabel={tocLabel}
      toc={toc}
      locale={locale}
    />

    <BlogArticleBlocks section={section} blocks={blocks} locale={locale} />

    {
      midCta && href && (
        <div class="mt-10">
          <a
            href={href}
            class="btn-primary"
            {...bf(`${section}.midCta`, "chrome_denied", section)}
          >
            {midCta}
          </a>
        </div>
      )
    }

    {
      quoteText && (
        <blockquote
          class="blog-quote"
          {...bf(`${section}.quote`, "style_target", section)}
        >
          <p>{quoteText}</p>
          {quoteAttr && <footer>{quoteAttr}</footer>}
        </blockquote>
      )
    }

    <BlogArticleFaq
      section={section}
      faqHeading={faqHeading}
      faq={faq}
      faqAnchorId={faqAnchorId}
      locale={locale}
    />

    <BlogArticleClosing
      section={section}
      locale={locale}
      summaryHeading={summaryHeading}
      summaryBody={summaryBody}
      summaryAnchorId={summaryAnchorId}
      closingHeading={closingHeading}
      closingBody={closingBody}
      closingCtaLabel={closingCtaLabel}
      closingAnchorId={closingAnchorId}
      authorBox={authorBox}
      href={href}
    />
  </div>
</section>
