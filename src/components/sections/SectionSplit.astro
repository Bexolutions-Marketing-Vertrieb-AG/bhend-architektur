---
// SectionSplit.astro — image + text (optional list / CTA / caption)
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import { resolveReservationHref } from "~/lib/reservation"
import type { ReservationMode } from "~/lib/reservation"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface ListItem {
  text?: I18nString
  body?: I18nString
}

interface Props {
  id?: string
  heading?: I18nString
  title?: I18nString
  body?: I18nString
  lead?: I18nString
  image?: string
  imageAlt?: I18nString
  imagePosition?: "left" | "right"
  caption?: I18nString
  items?: ListItem[]
  ctaLabel?: I18nString
  ctaHref?: string
  reservationMode?: ReservationMode
  reservationTarget?: string
  locale: Locale
}

const {
  id = "split",
  heading,
  title,
  body,
  lead,
  image,
  imageAlt,
  imagePosition = "left",
  caption,
  items = [],
  ctaLabel,
  ctaHref,
  reservationMode,
  reservationTarget,
  locale,
} = Astro.props

const section = id
const headline = translate(heading ?? title, locale)
const copy = translate(body ?? lead, locale)
const alt = translate(imageAlt, locale)
const credit = translate(caption, locale)
const cta = translate(ctaLabel, locale)
const href = resolveReservationHref({
  reservationMode,
  reservationTarget,
  ctaHref,
})
const imageFirst = imagePosition === "left"
---

<section
  class="bg-surface"
  {...bf(`home.${section}.shell`, "container", section)}
>
  <div class="container-wide py-section-sm md:py-section">
    <div
      class:list={[
        "grid items-center gap-10 lg:grid-cols-2 lg:gap-12",
        !imageFirst && "lg:[&>*:first-child]:order-2",
      ]}
    >
      {
        image && (
          <div>
            <img
              src={image}
              alt={alt}
              class="aspect-[580/650] w-full object-cover"
              width="580"
              height="650"
              loading="lazy"
              {...bf(`home.${section}.image`, "image", section)}
            />
          </div>
        )
      }
      <div class="flex flex-col justify-center">
        {
          headline && (
            <h2
              class="section-heading mb-6"
              {...bf(`home.${section}.heading`, "style_target", section)}
            >
              {headline}
            </h2>
          )
        }
        {
          copy && (
            <p
              class="section-lead whitespace-pre-line"
              {...bf(`home.${section}.body`, "style_target", section)}
            >
              {copy}
            </p>
          )
        }
        {
          items.length > 0 && (
            <ul class="mt-8 space-y-5">
              {items.map((item, index) => {
                const itemText = translate(item.text ?? item.body, locale)
                return (
                  <li class="flex gap-4">
                    <span
                      class="bg-brand-500 mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-white"
                      aria-hidden="true"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                    </span>
                    <p
                      class="section-lead"
                      {...bf(
                        `home.${section}.item${index + 1}`,
                        "style_target",
                        section,
                      )}
                    >
                      {itemText}
                    </p>
                  </li>
                )
              })}
            </ul>
          )
        }
        {
          cta && href && href !== "#" && (
            <a
              href={href}
              class="btn-primary mt-8 w-fit"
              {...bf(`home.${section}.cta`, "chrome_denied", section)}
            >
              {cta}
            </a>
          )
        }
      </div>
    </div>
    {
      credit && (
        <p
          class="text-muted mt-4 text-sm"
          {...bf(`home.${section}.caption`, "style_target", section)}
        >
          {credit}
        </p>
      )
    }
  </div>
</section>
