---
// SectionSplit.astro — image + text (optional list / CTA / caption)
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import { fotografCreditParts } from "~/lib/photo-credit"
import { resolveReservationHref } from "~/lib/reservation"
import type { ReservationMode } from "~/lib/reservation"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface ListItem {
  text?: I18nString
  body?: I18nString
}

interface Props {
  id?: string
  heading?: I18nString
  title?: I18nString
  body?: I18nString
  lead?: I18nString
  image?: string
  imageAlt?: I18nString
  imagePosition?: "left" | "right"
  caption?: I18nString
  items?: ListItem[]
  ctaLabel?: I18nString
  ctaHref?: string
  reservationMode?: ReservationMode
  reservationTarget?: string
  locale: Locale
}

const {
  id = "split",
  heading,
  title,
  body,
  lead,
  image,
  imageAlt,
  imagePosition = "left",
  caption,
  items = [],
  ctaLabel,
  ctaHref,
  reservationMode,
  reservationTarget,
  locale,
} = Astro.props

const section = id
const headline = translate(heading ?? title, locale)
const headlineLines = (() => {
  const lines = headline
    .split(/\n+/)
    .map((line) => line.trim())
    .filter(Boolean)
  if (section !== "challenges" || lines.length === 0) return lines
  // Design: first phrase stays together; each following word on its own line.
  const [first, ...rest] = lines
  return [first, ...rest.join(" ").split(/\s+/).filter(Boolean)]
})()
const copy = translate(body ?? lead, locale)
const copyParas = copy
  .split(/\n+/)
  .map((para) => para.trim())
  .filter(Boolean)
const alt = translate(imageAlt, locale)
const credit = translate(caption, locale)
const creditParts = credit ? fotografCreditParts(credit) : null
const cta = translate(ctaLabel, locale)
const href = resolveReservationHref({
  reservationMode,
  reservationTarget,
  ctaHref,
})
const imageFirst = imagePosition === "left"
---

<section
  class="bg-surface"
  {...bf(`home.${section}.shell`, "container", section)}
>
  <div class="container-wide py-section-sm md:py-section">
    <div
      class:list={[
        "grid items-center gap-10 lg:grid-cols-2 lg:gap-12",
        !imageFirst && "lg:[&>*:first-child]:order-2",
      ]}
    >
      {
        image && (
          <div>
            <img
              src={image}
              alt={alt}
              class="aspect-[580/650] w-full object-cover"
              width="580"
              height="650"
              loading="lazy"
              {...bf(`home.${section}.image`, "image", section)}
            />
          </div>
        )
      }
      <div class="flex flex-col justify-center">
        {
          headlineLines.length > 0 && (
            <div class="mb-6 flex flex-col gap-0">
              {headlineLines.map((line, index) => {
                const isChallengesHeading = section === "challenges"
                // First group: "Private und Öffentliche" + "Bauprojekte" (48/56)
                const isChallengesLead = isChallengesHeading && index < 2
                // 15px gap below "Bauprojekte" before the larger lines
                const isBauprojekteLine = isChallengesLead && index === 1
                return (
                  <h2
                    class:list={[
                      isChallengesLead
                        ? "heading-section text-ink"
                        : isChallengesHeading
                          ? "heading-page text-ink"
                          : "section-heading",
                      isBauprojekteLine && "pb-[15px]",
                    ]}
                    {...bf(
                      index === 0
                        ? `home.${section}.heading`
                        : `home.${section}.heading${index + 1}`,
                      "style_target",
                      section,
                    )}
                  >
                    {line}
                  </h2>
                )
              })}
            </div>
          )
        }
        {
          copyParas.length > 0 && (
            <div
              class="space-y-5"
              {...bf(`home.${section}.body`, "style_target", section)}
            >
              {copyParas.map((para) => (
                <p class="section-lead">{para}</p>
              ))}
            </div>
          )
        }
        {
          items.length > 0 && (
            <ul class="mt-8 space-y-5">
              {items.map((item, index) => {
                const itemText = translate(item.text ?? item.body, locale)
                return (
                  <li class="flex gap-4">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="56"
                      height="56"
                      viewBox="0 0 56 56"
                      fill="none"
                      aria-hidden="true"
                      class="text-brand-500 mt-1 size-14 shrink-0"
                    >
                      <path
