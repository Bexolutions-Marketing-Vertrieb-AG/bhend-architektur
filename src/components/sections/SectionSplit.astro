                        fill="currentColor"
                      />
                    </svg>
                    <p
                      class="section-lead"
                      {...bf(
                        `home.${section}.item${index + 1}`,
                        "style_target",
                        section,
                      )}
                    >
                      {itemText}
                    </p>
                  </li>
                )
              })}
            </ul>
          )
        }
        {
          cta && href && href !== "#" && (
            <a
              href={href}
              class="btn-primary mt-8 w-fit"
              {...bf(`home.${section}.cta`, "chrome_denied", section)}
            >
              {cta}
            </a>
          )
        }
      </div>
    </div>
    {
      credit && (
        <p
          class="text-muted mt-4 text-sm"
          {...bf(`home.${section}.caption`, "style_target", section)}
        >
          {creditParts ? (
            <>
              <strong class="font-bold">{creditParts.label}</strong>
              {creditParts.rest}
            </>
          ) : (
            credit
          )}
        </p>
      )
    }
  </div>
</section>
