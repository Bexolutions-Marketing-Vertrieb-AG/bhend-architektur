---
// SectionPageHero.astro — page title + full-width banner image
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  id?: string
  title?: I18nString
  heading?: I18nString
  image?: string
  imageAlt?: I18nString
  locale: Locale
}

const { id = "pageHero", title, heading, image, imageAlt, locale } = Astro.props
const section = id
const headline = translate(heading ?? title, locale)
const alt = translate(imageAlt, locale)
---

<section class="bg-white" {...bf(`${section}.shell`, "container", section)}>
  <div class="container-wide py-section-sm md:pt-section md:pb-10">
    {
      headline && (
        <h1
          class:list={[
            "mb-10 uppercase",
            section === "teamHero" ? "heading-page" : "heading-section",
          ]}
          {...bf(`${section}.heading`, "style_target", section)}
        >
          {headline}
        </h1>
      )
    }
    {
      image && (
        <img
          src={image}
          alt={alt}
          class="aspect-[1200/629] w-full object-cover"
          width="1200"
          height="629"
          loading="eager"
          {...bf(`${section}.image`, "image", section)}
        />
      )
    }
  </div>
</section>
