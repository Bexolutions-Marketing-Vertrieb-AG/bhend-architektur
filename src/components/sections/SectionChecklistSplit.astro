---
// SectionChecklistSplit.astro — body + image | checklist with check icons
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import { creditLines } from "~/lib/photo-credit"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Item {
  title?: I18nString
  text?: I18nString
  body?: I18nString
}

interface Props {
  id?: string
  title?: I18nString
  heading?: I18nString
  body?: I18nString
  /** H4 above the checklist lead (right column) */
  listHeading?: I18nString
  lead?: I18nString
  /** Plain sentence after the checklist (no checkmark) */
  note?: I18nString
  image?: string
  imageAlt?: I18nString
  imageCaption?: I18nString
  tone?: "light" | "dark"
  items?: Item[]
  locale: Locale
}

const {
  id = "checklist",
  title,
  heading,
  body,
  listHeading,
  lead,
  note,
  image,
  imageAlt,
  imageCaption,
  tone = "light",
  items = [],
  locale,
} = Astro.props
const section = id
const dark = tone === "dark"
const headline = translate(heading ?? title, locale)
const copy = translate(body, locale)
const listTitle = translate(listHeading, locale)
const listLead = translate(lead, locale)
const listNote = translate(note, locale)
const alt = translate(imageAlt, locale)
const caption = translate(imageCaption, locale)
const lines = caption ? creditLines(caption) : []
const isLeistungen =
  /^(planung|beratung|brandschutz|realisierung|energieberatung|bauherrenberatung)/.test(
    section,
  )
const bodyClass = isLeistungen ? "leistungen-body" : "section-lead"
const leadClass =
  section === "energieberatungProcess" || section === "bauherrenberatungProcess"
    ? "leistungen-process-lead"
    : bodyClass
const itemTitleClass =
  section === "bauherrenberatungProcess"
    ? "leistungen-checklist-plain"
    : isLeistungen
      ? "leistungen-item-title"
      : "font-display text-lg font-bold whitespace-pre-line"
const headingClass =
  section === "brandschutzProcess"
    ? "leistungen-process-intro"
    : "font-display text-3xl font-bold tracking-tight md:text-4xl"
---

<section
  class:list={[dark ? "bg-brand-900 text-white" : "text-ink bg-white"]}
  {...bf(`${section}.shell`, "container", section)}
>
  <div class="container-wide py-section-sm md:py-section">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col gap-8">
        {
          headline && (
            <h2
              class:list={[headingClass, dark && "text-brand-100"]}
              {...bf(`${section}.heading`, "style_target", section)}
            >
              {headline}
            </h2>
          )
        }
        {
          copy && (
            <p
              class:list={[bodyClass, dark ? "text-brand-200" : "text-ink"]}
              {...bf(`${section}.body`, "style_target", section)}
            >
              {copy}
            </p>
          )
        }
        {
          image && (
            <figure>
              <img
                src={image}
                alt={alt}
                class="w-full object-cover"
                loading="lazy"
                {...bf(`${section}.image`, "image", section)}
              />
              {caption && (
                <figcaption
                  class:list={[
                    "mt-3 text-sm",
                    dark ? "text-brand-200" : "text-muted",
                  ]}
                  {...bf(`${section}.imageCaption`, "style_target", section)}
                >
                  {lines.length > 0
                    ? lines.map((line, index) => (
                        <>
                          {index > 0 && " | "}
                          {line.label ? (
                            <>
                              <strong class="font-bold">{line.label}</strong>
                              {line.rest}
                            </>
                          ) : (
                            line.rest
                          )}
                        </>
                      ))
                    : caption}
                </figcaption>
              )}
            </figure>
          )
        }
      </div>
      <div class="flex flex-col gap-8">
        {
          listTitle && (
            <h3
              class:list={[
                "font-display text-[28px] leading-10 font-bold",
                dark ? "text-brand-100" : "text-ink",
              ]}
              {...bf(`${section}.listHeading`, "style_target", section)}
            >
              {listTitle}
            </h3>
          )
        }
        {
          listLead && (
            <p
              class:list={[leadClass, dark ? "text-brand-100" : "text-ink"]}
              {...bf(`${section}.lead`, "style_target", section)}
            >
              {listLead}
            </p>
          )
        }
        <ul class="space-y-6">
          {
            items.map((item, index) => {
              const n = index + 1
              const itemTitle = translate(item.title, locale)
              const itemBody = translate(item.text ?? item.body, locale)
              return (
                <li class="flex gap-4">
                  <span
                    class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center"
                    aria-hidden="true"
                  >
                    <img
                      src="/images/icons/check-badge.png"
                      alt=""
                      width="40"
                      height="40"
                      class="h-10 w-10"
                    />
                  </span>
                  <div class="flex flex-col gap-1">
                    {itemTitle && (
                      <h3
                        class:list={[
                          itemTitleClass,
                          dark ? "text-brand-100" : "text-ink",
                        ]}
                        {...bf(
                          `${section}.item${n}Title`,
                          "style_target",
                          section,
                        )}
                      >
                        {itemTitle}
                      </h3>
                    )}
                    {itemBody && (
                      <p
                        class:list={[
                          bodyClass,
                          dark ? "text-brand-200" : "text-ink",
                        ]}
                        {...bf(
                          `${section}.item${n}Body`,
                          "style_target",
                          section,
                        )}
                      >
                        {itemBody}
                      </p>
                    )}
                  </div>
                </li>
              )
            })
          }
        </ul>
        {
          listNote && (
            <p
              class:list={[bodyClass, dark ? "text-brand-200" : "text-ink"]}
              {...bf(`${section}.note`, "style_target", section)}
            >
              {listNote}
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>
