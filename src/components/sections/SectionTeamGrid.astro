---
/**
 * SectionTeamGrid — portrait grid of team members.
 *
 * {
 *   "id": "teamGrid",
 *   "members": [
 *     {
 *       "name": { "de": "Stefanie Burren" },
 *       "role": { "de": "Zeichnerin EFZ Architektur" },
 *       "studies": [],
 *       "image": "/images/team/stefanie-burren.jpg",
 *       "imageAlt": { "de": "Stefanie Burren" },
 *       "phone": "+41 62 798 1071",
 *       "email": "stefanie.burren@bhend-architektur.ch",
 *       "mailLabel": { "de": "Mail" }
 *     }
 *   ],
 *   "_orbi": { "component": "SectionTeamGrid" }
 * }
 *
 * Alta/baja: skills /new-employe y /delete-employe (members[] por name.de).
 */
import { bf } from "~/lib/bf"
import type { Locale } from "~/config/locales"
import TeamMemberCard, {
  type TeamMember,
} from "./partials/TeamMemberCard.astro"

interface Props {
  id?: string
  members?: TeamMember[]
  locale: Locale
}

const { id = "team", members = [], locale } = Astro.props
const section = id
---

<section class="bg-white" {...bf(`${section}.shell`, "container", section)}>
  <div class="container-wide py-section-sm md:pb-section">
    <ul class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        members.map((member, index) => (
          <TeamMemberCard
            member={member}
            locale={locale}
            bfPrefix={`${section}.member${index + 1}`}
            section={section}
          />
        ))
      }
    </ul>
  </div>
</section>
