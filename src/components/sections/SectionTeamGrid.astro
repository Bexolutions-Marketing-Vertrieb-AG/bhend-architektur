---
// SectionTeamGrid.astro — portrait grid; roles collapse under name click
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Member {
  name?: I18nString
  roles?: I18nString[]
  image?: string
  imageAlt?: I18nString
  phone?: string
  email?: string
  mailLabel?: I18nString
}

interface Props {
  id?: string
  members?: Member[]
  locale: Locale
}

const { id = "team", members = [], locale } = Astro.props
const section = id
const telHref = (phone: string) => {
  const digits = phone.replace(/[^\d+]/g, "")
  return digits ? `tel:${digits}` : "#"
}
---

<section class="bg-white" {...bf(`${section}.shell`, "container", section)}>
  <div class="container-wide py-section-sm md:pb-section">
    <ul class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        members.map((member, index) => {
          const name = translate(member.name, locale)
          const alt = translate(member.imageAlt, locale) || name
          const mailLabel = translate(member.mailLabel, locale) || "Mail"
          const roles = (member.roles ?? [])
            .map((role) => translate(role, locale))
            .filter(Boolean)
          const phone = (member.phone ?? "").trim()
          const email = (member.email ?? "").trim()
          const n = index + 1
          const expandable = roles.length > 1
          const nameBf = bf(
            `${section}.member${n}Name`,
            "style_target",
            section,
          )
          const rolesBf = bf(
            `${section}.member${n}Roles`,
            "style_target",
            section,
          )
          return (
            <li class="flex flex-col gap-4">
              {member.image && (
                <img
                  src={member.image}
                  alt={alt}
                  class="aspect-square w-full object-cover object-top"
                  width="241"
                  height="241"
                  loading="lazy"
                  {...bf(`${section}.member${n}Image`, "image", section)}
                />
              )}
              {expandable ? (
                <details class="group">
                  <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    <h2 class="font-display text-xl font-bold" {...nameBf}>
                      {name}
                      <span class="group-open:hidden" aria-hidden="true">
                        {" "}
                        +
                      </span>
                      <span class="hidden group-open:inline" aria-hidden="true">
                        {" "}
                        –
                      </span>
                    </h2>
                    <p class="text-ink mt-1 text-sm leading-snug">{roles[0]}</p>
                  </summary>
                  <ul
                    class="text-ink mt-0.5 space-y-0.5 text-sm leading-snug"
                    {...rolesBf}
                  >
                    {roles.slice(1).map((role) => (
                      <li>{role}</li>
                    ))}
                  </ul>
                </details>
              ) : (
                <div>
                  {name && (
                    <h2 class="font-display text-xl font-bold" {...nameBf}>
                      {name}
                      <span aria-hidden="true"> –</span>
                    </h2>
                  )}
                  {roles[0] && (
                    <p class="text-ink mt-1 text-sm leading-snug" {...rolesBf}>
                      {roles[0]}
                    </p>
                  )}
                </div>
              )}
              <div class="mt-auto flex flex-col gap-2 pt-2 text-sm">
                {phone && (
                  <a
                    href={telHref(phone)}
                    class="enter:text-brand-500 text-brand-500 inline-flex items-center gap-2"
                    {...bf(
                      `${section}.member${n}Phone`,
                      "chrome_denied",
                      section,
                    )}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z" />
                    </svg>
                    {phone}
                  </a>
                )}
                <Fragment>
                  {email ? (
                    <a
                      href={`mailto:${email}`}
                      class="enter:text-brand-500 text-brand-500 inline-flex items-center gap-2"
                      {...bf(
                        `${section}.member${n}Mail`,
                        "chrome_denied",
                        section,
                      )}
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5L4 8V6l8 5 8-5v2z" />
                      </svg>
                      {mailLabel}
                    </a>
                  ) : (
                    <span
                      class="text-brand-500 inline-flex items-center gap-2"
                      {...bf(
                        `${section}.member${n}Mail`,
                        "chrome_denied",
                        section,
                      )}
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5L4 8V6l8 5 8-5v2z" />
                      </svg>
                      {mailLabel}
                    </span>
                  )}
                </Fragment>
              </div>
            </li>
          )
        })
      }
    </ul>
  </div>
</section>
