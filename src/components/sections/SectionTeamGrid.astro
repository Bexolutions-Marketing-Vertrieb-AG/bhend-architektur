---
/**
 * SectionTeamGrid — portrait grid of team members.
 *
 * {
 *   "id": "teamGrid",
 *   "members": [
 *     {
 *       "name": { "de": "Stefanie Burren" },
 *       "role": { "de": "Zeichnerin EFZ Architektur" },
 *       "studies": [],
 *       "image": "/images/team/stefanie-burren.jpg",
 *       "imageAlt": { "de": "Stefanie Burren" },
 *       "phone": "+41 62 798 1071",
 *       "email": "stefanie.burren@bhend-architektur.ch",
 *       "mailLabel": { "de": "Mail" }
 *     }
 *   ],
 *   "_orbi": { "component": "SectionTeamGrid" }
 * }
 *
 * Alta/baja: skills /new-employe y /delete-employe (members[] por name.de).
 */
import { bf } from "~/lib/bf"
import JsonLd from "~/components/seo/JsonLd.astro"
import type { Locale } from "~/config/locales"
import { translate } from "~/lib/i18n"
import { absoluteUrl, organizationName } from "~/lib/site"
import TeamMemberCard, {
  type TeamMember,
} from "./partials/TeamMemberCard.astro"

interface Props {
  id?: string
  members?: TeamMember[]
  locale: Locale
}

const { id = "team", members = [], locale } = Astro.props
const section = id
const people = members.flatMap((member) => {
  const name = translate(member.name, locale).trim()
  if (!name) return []
  const jobTitle = translate(member.role, locale).trim()
  return [
    {
      "@type": "Person",
      name,
      ...(jobTitle ? { jobTitle } : {}),
      url: absoluteUrl("/ueber-uns/team"),
      worksFor: {
        "@type": "Organization",
        name: organizationName(),
      },
    },
  ]
})
---

<section class="bg-white" {...bf(`${section}.shell`, "container", section)}>
  <div class="container-wide py-section-sm md:pb-section">
    <ul class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        members.map((member, index) => (
          <TeamMemberCard
            member={member}
            locale={locale}
            bfPrefix={`${section}.member${index + 1}`}
            section={section}
          />
        ))
      }
    </ul>
  </div>
  {
    people.length > 0 && (
      <JsonLd
        data={{
          "@context": "https://schema.org",
          "@graph": people,
        }}
      />
    )
  }
</section>
