---
// SectionCta.astro — conversion band
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import { resolveReservationHref } from "~/lib/reservation"
import type { ReservationMode } from "~/lib/reservation"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  id?: string
  title?: I18nString
  heading?: I18nString
  eyebrow?: I18nString
  text?: I18nString
  lead?: I18nString
  ctaLabel?: I18nString
  ctaHref?: string
  reservationMode?: ReservationMode
  reservationTarget?: string
  locale: Locale
}

const {
  id = "cta",
  title,
  heading,
  eyebrow,
  text,
  lead,
  ctaLabel,
  ctaHref = "#",
  reservationMode,
  reservationTarget,
  locale,
} = Astro.props
const section = id
const kicker = translate(eyebrow, locale)
const headline = translate(heading ?? title, locale)
const body = translate(text ?? lead, locale)
const cta = translate(ctaLabel, locale)
const href = resolveReservationHref({
  reservationMode,
  reservationTarget,
  ctaHref,
})
const isLeistungenCta =
  /^(planung|beratung|brandschutz|realisierung|energieberatung|bauherrenberatung)/.test(
    section,
  )
---

<section
  class:list={[isLeistungenCta ? "bg-white" : "bg-surface"]}
  {...bf(`${section}.shell`, "container", section)}
>
  <div class:list={[isLeistungenCta && "bg-brand-50 leistungen-cta-slant"]}>
    <div
      class:list={[
        "container-wide flex flex-col items-start text-left",
        !isLeistungenCta && "py-section",
      ]}
    >
      {
        kicker && (
          <p
            class:list={[
              isLeistungenCta
                ? "leistungen-cta-eyebrow mb-3"
                : "text-muted mb-3 text-sm",
            ]}
            {...bf(`${section}.eyebrow`, "style_target", section)}
          >
            {kicker}
          </p>
        )
      }
      {
        headline && (
          <h2
            class:list={[
              isLeistungenCta
                ? "leistungen-cta-heading mb-6 max-w-4xl"
                : "section-heading mb-6 max-w-4xl",
            ]}
            {...bf(`${section}.heading`, "style_target", section)}
          >
            {headline}
          </h2>
        )
      }
      {
        body && (
          <p
            class:list={[
              isLeistungenCta
                ? "leistungen-cta-body mb-8 max-w-2xl"
                : "section-lead mb-8 max-w-2xl",
            ]}
            {...bf(`${section}.body`, "style_target", section)}
          >
            {body}
          </p>
        )
      }
      {
        cta && (
          <a
            href={href}
            class:list={[
              isLeistungenCta ? "leistungen-cta-button" : "btn-primary",
            ]}
            {...bf(`${section}.cta`, "chrome_denied", section)}
          >
            {cta}
          </a>
        )
      }
    </div>
  </div>
</section>
