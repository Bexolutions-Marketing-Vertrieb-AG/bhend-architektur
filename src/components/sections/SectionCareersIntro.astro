---
// SectionCareersIntro.astro — careers hero: title, photo, dual lead copy
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  id?: string
  title?: I18nString
  heading?: I18nString
  body?: I18nString
  bodySecondary?: I18nString
  image?: string
  imageAlt?: I18nString
  locale: Locale
}

const {
  id = "careersIntro",
  title,
  heading,
  body,
  bodySecondary,
  image,
  imageAlt,
  locale,
} = Astro.props

const section = id
const headline = translate(heading ?? title, locale)
const primary = translate(body, locale)
const secondary = translate(bodySecondary, locale)
const alt = translate(imageAlt, locale) || headline
---

<section class="bg-white" {...bf(`${section}.shell`, "container", section)}>
  <div class="container-wide py-section-sm md:pt-section md:pb-section">
    {
      headline && (
        <h1
          class="font-display mb-10 text-4xl font-bold tracking-tight uppercase md:mb-12 md:text-5xl"
          {...bf(`${section}.heading`, "style_target", section)}
        >
          {headline}
        </h1>
      )
    }
    {
      image && (
        <img
          src={image}
          alt={alt}
          class="mb-10 aspect-[1205/585] w-full object-cover md:mb-12"
          width="1205"
          height="585"
          loading="eager"
          {...bf(`${section}.image`, "image", section)}
        />
      )
    }
    <div class="mx-auto flex max-w-[980px] flex-col gap-6">
      {
        primary && (
          <p
            class="font-display text-xl leading-snug font-bold tracking-tight uppercase md:text-2xl"
            {...bf(`${section}.body`, "style_target", section)}
          >
            {primary}
          </p>
        )
      }
      {
        secondary && (
          <p
            class="section-lead whitespace-pre-line"
            {...bf(`${section}.bodySecondary`, "style_target", section)}
          >
            {secondary}
          </p>
        )
      }
    </div>
  </div>
</section>
