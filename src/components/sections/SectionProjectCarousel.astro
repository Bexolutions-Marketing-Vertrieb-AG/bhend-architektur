---
// SectionProjectCarousel.astro — CSS scroll-snap project band (no client framework)
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Item {
  title?: I18nString
  text?: I18nString
  body?: I18nString
  image?: string
  imageAlt?: I18nString
}

interface Props {
  id?: string
  items?: Item[]
  locale: Locale
}

const { id = "projects", items = [], locale } = Astro.props
const section = id
const slideCount = items.length
---

<section
  class="bg-surface overflow-hidden"
  {...bf(`home.${section}.shell`, "container", section)}
>
  <div class="py-section-sm md:py-section relative">
    <div
      id={`${section}-track`}
      class="flex snap-x snap-mandatory [scrollbar-width:none] overflow-x-auto scroll-smooth [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        items.map((item, index) => {
          const itemTitle = translate(item.title, locale)
          const itemBody = translate(item.text ?? item.body, locale)
          const alt = translate(item.imageAlt, locale)
          return (
            <article
              id={`${section}-slide-${index}`}
              class="w-full shrink-0 snap-center px-6"
            >
              <div class="mx-auto max-w-[1138px]">
                {item.image && (
                  <img
                    src={item.image}
                    alt={alt}
                    class="mb-6 aspect-[1138/640] w-full object-cover"
                    width="1138"
                    height="640"
                    loading="lazy"
                    {...bf(`home.${section}.image`, "image", section)}
                  />
                )}
                {itemTitle && (
                  <h2
                    class="font-display mb-2 text-2xl font-bold md:text-3xl"
                    {...bf(`home.${section}.heading`, "style_target", section)}
                  >
                    {itemTitle}
                  </h2>
                )}
                {itemBody && (
                  <p
                    class="section-lead"
                    {...bf(`home.${section}.body`, "style_target", section)}
                  >
                    {itemBody}
                  </p>
                )}
              </div>
            </article>
          )
        })
      }
    </div>

    {
      slideCount > 1 && (
        <div class="pointer-events-none absolute inset-y-0 right-0 left-0 flex items-center justify-between px-4 md:px-8">
          <a
            href={`#${section}-slide-0`}
            class="bg-brand-500 pointer-events-auto flex h-[72px] w-[72px] items-center justify-center rounded-full text-white"
            aria-label="Previous"
            {...bf(`home.${section}.prev`, "chrome_denied", section)}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <polyline points="15 18 9 12 15 6" />
            </svg>
          </a>
          <a
            href={`#${section}-slide-${Math.min(1, slideCount - 1)}`}
            class="bg-brand-500 pointer-events-auto flex h-[72px] w-[72px] items-center justify-center rounded-full text-white"
            aria-label="Next"
            {...bf(`home.${section}.next`, "chrome_denied", section)}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</section>
