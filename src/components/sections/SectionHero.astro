---
// SectionHero.astro — brand split hero (Home)
import { translate } from "~/lib/i18n"
import { bf } from "~/lib/bf"
import { resolveReservationHref } from "~/lib/reservation"
import type { ReservationMode } from "~/lib/reservation"
import type { I18nString } from "~/types/i18n"
import type { Locale } from "~/config/locales"

interface Props {
  title?: I18nString
  lead?: I18nString
  ctaLabel?: I18nString
  ctaHref?: string
  reservationMode?: ReservationMode
  reservationTarget?: string
  image?: string
  img?: string
  imageAlt?: I18nString
  locale: Locale
}

const {
  title,
  lead,
  ctaLabel,
  ctaHref,
  reservationMode,
  reservationTarget,
  image,
  img,
  imageAlt,
  locale,
} = Astro.props
const heading = translate(title, locale)
const body = translate(lead, locale)
const cta = translate(ctaLabel, locale)
const media = image || img || ""
const alt = translate(imageAlt, locale)
const href = resolveReservationHref({
  reservationMode,
  reservationTarget,
  ctaHref,
})
---

<section class="bg-surface" {...bf("home.hero.shell", "container", "hero")}>
  <div
    class="container-wide py-section grid items-stretch gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-12"
  >
    <div class="flex flex-col justify-center">
      {
        heading && (
          <h1
            class="font-display mb-6 text-[58px] leading-[1.1] font-bold tracking-tight uppercase md:text-[70px]"
            {...bf("home.hero.heading", "style_target", "hero")}
          >
            {heading}
          </h1>
        )
      }
      {
        body && (
          <p
            class="font-display text-3xl leading-snug font-bold text-balance md:text-4xl"
            {...bf("home.hero.body", "style_target", "hero")}
          >
            {body}
          </p>
        )
      }
      {
        cta && href && href !== "#" && (
          <a
            href={href}
            class="btn-primary mt-8 w-fit"
            {...bf("home.hero.cta", "chrome_denied", "hero")}
          >
            {cta}
          </a>
        )
      }
    </div>
    {
      media && (
        <img
          src={media}
          alt={alt}
          class="h-full min-h-[320px] w-full object-cover lg:min-h-[650px]"
          width="685"
          height="650"
          loading="eager"
          {...bf("home.hero.image", "image", "hero")}
        />
      )
    }
  </div>
</section>
