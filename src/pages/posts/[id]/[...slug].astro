---
import Base from "~/layouts/Base.astro"
import Seo from "~/components/seo/Seo.astro"
import JsonLd from "~/components/seo/JsonLd.astro"
import AnySection from "~/components/sections/AnySection.astro"
import { DEFAULT_LOCALE } from "~/config/locales"
import { getPost, listPublishedPostIds } from "~/lib/orbitype/posts"
import { OrbitypeError } from "~/lib/orbitype/client"
import { buildPostSeo } from "~/lib/seo"
import { postPath, postTitleSlug } from "~/lib/post-slug"

export const prerender = import.meta.env.RENDER_MODE === "static"

export async function getStaticPaths() {
  if (import.meta.env.RENDER_MODE !== "static") return []

  const posts = await listPublishedPostIds()
  return posts.map((post) => {
    const slug = postTitleSlug(post.title)
    return {
      params: {
        id: post.id,
        slug: slug || undefined,
      },
    }
  })
}

const locale = DEFAULT_LOCALE
const id = Astro.params.id
if (!id) return Astro.rewrite("/404")

let post
try {
  post = await getPost(id)
} catch (error) {
  if (import.meta.env.RENDER_MODE === "static") throw error
  if (error instanceof OrbitypeError && error.isUnavailable) {
    if (Astro.cache.enabled) Astro.cache.set(false)
    return new Response(
      "Service temporarily unavailable. Please try again shortly.",
      {
        status: 503,
        headers: {
          "Content-Type": "text/plain; charset=utf-8",
          "Retry-After": "60",
          "Cache-Control": "no-store",
        },
      },
    )
  }
  throw error
}
if (!post) return Astro.rewrite("/404")

const canonicalSlug = postTitleSlug(post.title, locale)
const requestedSlug = Array.isArray(Astro.params.slug)
  ? Astro.params.slug.join("/")
  : (Astro.params.slug ?? "")

if (canonicalSlug && requestedSlug !== canonicalSlug) {
  return Astro.redirect(postPath(post.id, canonicalSlug), 301)
}

const canonicalPath = postPath(post.id, canonicalSlug)

if (Astro.cache.enabled) {
  Astro.cache.set({
    tags: [`post:${post.id}`, "posts"],
    lastModified: post.updated_at ? new Date(post.updated_at) : undefined,
  })
}

const seo = buildPostSeo({
  post,
  locale,
  path: canonicalPath,
})

const hasArticleSection = post.sections.some(
  (section) => section._orbi?.component === "SectionBlogArticle",
)
---

<Base locale={locale}>
  <Fragment slot="head">
    <Seo {...seo} />
    <JsonLd data={seo.jsonLd} />
  </Fragment>
  <main>
    {
      post.sections.map((section) => (
        <AnySection data={section} locale={locale} />
      ))
    }
    {
      !hasArticleSection && (
        <p class="container-prose text-muted py-section text-sm">
          Dieser Beitrag hat noch keinen Artikelinhalt.
        </p>
      )
    }
  </main>
</Base>
